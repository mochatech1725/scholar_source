{
  "version": 2,
  "suite": "scholar_source_rag_golden_cases",
  "description": "Seed golden cases for evaluating ScholarSource RAG retrieval, source quality, citation coverage, and grounded synthesis. Universal forbidden domains live in shared_forbidden_domains and apply to every case; a case may extend (never replace) them via additional_forbidden_domains.",
  "shared_forbidden_domains": [
    "chegg.com",
    "coursehero.com",
    "studocu.com"
  ],
  "cases": [
    {
      "id": "baseline_engineering_statics_course",
      "input": {
        "course_url": "https://www.mccormick.northwestern.edu/civil-environmental/academics/courses/descriptions/GEN_ENG%20205-2.html",
        "course_name": "",
        "textbook": "",
        "topics_list": []
      },
      "expected_domains": [
        "mit.edu",
        "purdue.edu",
        "libretexts.org"
      ],
      "additional_forbidden_domains": [
        "quizlet.com"
      ],
      "expected_concepts": [
        "engineering mechanics",
        "statics",
        "free body diagrams",
        "equilibrium",
        "moments"
      ],
      "notes": "Baseline case used during Phase 0 diagnosis. Good output should prefer accessible university or open educational resources and avoid answer-key style sites."
    },
    {
      "id": "applied_math_vector_calculus_course",
      "input": {
        "course_url": "https://www.mccormick.northwestern.edu/applied-math/academics/courses/descriptions/228-2-1.html",
        "course_name": "",
        "textbook": "",
        "topics_list": []
      },
      "expected_domains": [
        "mit.edu",
        "libretexts.org",
        "tutorial.math.lamar.edu"
      ],
      "expected_concepts": [
        "vector calculus",
        "multiple integrals",
        "line integrals",
        "surface integrals",
        "green's theorem"
      ],
      "notes": "Course-based query where good sources should be concept-aligned rather than generic calculus search results."
    },
    {
      "id": "topic_based_organic_chemistry_sn1_sn2",
      "input": {
        "course_url": "",
        "course_name": "Organic Chemistry I",
        "textbook": "",
        "topics_list": [
          "SN1 reactions",
          "SN2 reactions",
          "nucleophilic substitution"
        ]
      },
      "expected_domains": [
        "libretexts.org",
        "khanacademy.org",
        "masterorganicchemistry.com"
      ],
      "expected_concepts": [
        "nucleophile",
        "leaving group",
        "stereochemistry",
        "carbocation",
        "reaction mechanism"
      ],
      "notes": "Topic-based query used to verify the pipeline can work without a course URL or textbook metadata."
    },
    {
      "id": "textbook_based_intro_statistics",
      "input": {
        "course_url": "",
        "course_name": "Introductory Statistics",
        "textbook": "OpenIntro Statistics",
        "topics_list": [
          "confidence intervals",
          "hypothesis testing",
          "p-values"
        ]
      },
      "expected_domains": [
        "openintro.org",
        "stattrek.com",
        "khanacademy.org"
      ],
      "expected_concepts": [
        "sampling distribution",
        "confidence interval",
        "null hypothesis",
        "p-value",
        "statistical significance"
      ],
      "notes": "Textbook-aware query where useful output should align resources with named chapters or concepts instead of broad statistics pages."
    },
    {
      "id": "weak_evidence_guard_answer_key_trap",
      "input": {
        "course_url": "",
        "course_name": "Calculus II",
        "textbook": "",
        "topics_list": [
          "integration by parts practice test",
          "exam solutions"
        ]
      },
      "expected_domains": [
        "mit.edu",
        "libretexts.org",
        "tutorial.math.lamar.edu"
      ],
      "additional_forbidden_domains": [
        "slader.com"
      ],
      "expected_concepts": [
        "integration by parts",
        "u-substitution",
        "definite integrals",
        "practice problems"
      ],
      "notes": "Low-quality-source trap. Good output should reject answer-key and homework-solution sites and return a weak-evidence warning if credible sources are insufficient."
    },
    {
      "id": "topic_based_history_french_revolution",
      "input": {
        "course_url": "",
        "course_name": "Modern European History",
        "textbook": "",
        "topics_list": [
          "the French Revolution",
          "causes of the French Revolution",
          "the Reign of Terror"
        ]
      },
      "expected_domains": [
        "fordham.edu",
        "khanacademy.org",
        "wikipedia.org"
      ],
      "additional_forbidden_domains": [
        "quizlet.com"
      ],
      "expected_concepts": [
        "estates general",
        "storming of the bastille",
        "declaration of the rights of man",
        "reign of terror",
        "napoleon"
      ],
      "notes": "Humanities coverage case. Sources are long-form prose and primary documents rather than problem sets; verifies retrieval and chunking are not tuned only for STEM content."
    },
    {
      "id": "textbook_based_literature_hamlet",
      "input": {
        "course_url": "",
        "course_name": "Introduction to Shakespeare",
        "textbook": "The Norton Shakespeare",
        "topics_list": [
          "Hamlet",
          "close reading",
          "soliloquy analysis"
        ]
      },
      "expected_domains": [
        "folger.edu",
        "gutenberg.org",
        "poetryfoundation.org"
      ],
      "additional_forbidden_domains": [
        "sparknotes.com",
        "gradesaver.com",
        "enotes.com"
      ],
      "expected_concepts": [
        "soliloquy",
        "tragedy",
        "revenge",
        "elizabethan theater",
        "iambic pentameter"
      ],
      "notes": "Literature coverage case and humanities answer-mill trap. Good output should favor primary texts and scholarly resources over plot-summary and essay-mill sites."
    }
  ]
}
